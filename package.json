{
    "name": "skyrim-book-tracker",
    "version": "0.1.0",
    "private": true,
    "license": "GPL-3.0-or-later",
    "packageManager": "yarn@4.17.1",
    "engines": {
        "node": "24.x"
    },
    "dependencies": {
        "@supabase/ssr": "^0.12.4",
        "@supabase/supabase-js": "^2.112.2",
        "next": "^16.3.8",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "server-only": "^0.0.1"
    },
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "typegen": "next typegen",
        "start": "next start",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "tsx --test \"scripts/**/*.test.mts\" \"src/**/*.test.ts\"",
        "test:db": "tsx --test --test-concurrency=1 \"tests/db/**/*.test.mts\"",
        "import:uesp": "node --env-file-if-exists=.env.local --import tsx scripts/import-uesp.mts",
        "privacy:request": "node --import tsx scripts/privacy-request.mts"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.3",
        "@types/node": "^26.2.0",
        "@types/react": "^19.2.18",
        "@types/sax": "^1.2.7",
        "eslint": "^9",
        "eslint-config-next": "^16.3.8",
        "postcss": "^8.5.26",
        "prettier": "^3.9.6",
        "sax": "^1.6.1",
        "tailwindcss": "^4.3.3",
        "tsx": "^4.23.13",
        "typescript": "6.0.3"
    }
}
